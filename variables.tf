variable "proxmox_connection" {
  description = "Proxmox host connection details for SSH provisioning."
  sensitive   = true
  type = object({
    host     = optional(string)
    password = optional(string)
  })
  default = {}
}

variable "proxmox_download_files" {
  description = "Proxmox download file configuration"
  type = map(object({
    checksum                = optional(string)
    checksum_algorithm      = optional(string)
    content_type            = optional(string)
    datastore_id            = string
    decompression_algorithm = optional(string)
    file_name               = optional(string)
    node_name               = string
    overwrite               = optional(bool)
    overwrite_unmanaged     = optional(bool)
    upload_timeout          = optional(number)
    url                     = string
  }))
  default = {}
}

variable "proxmox_linux_containers" {
  description = "Proxmox LXC configuration"
  type = map(object({
    clone = optional(object({
      datastore_id = optional(string)
      full         = optional(bool)
      node_name    = optional(string)
      vm_id        = optional(number)
    }))
    console = optional(object({
      enabled   = optional(bool)
      tty_count = optional(number)
      type      = optional(string)
    }))
    cpu = optional(object({
      architecture = optional(string)
      cores        = optional(number)
      limit        = optional(number)
      units        = optional(number)
    }))
    delete_unreferenced_disks_on_destroy = optional(bool)
    description                          = optional(string)
    device_passthrough = optional(list(object({
      deny_write = optional(bool)
      gid        = optional(number)
      mode       = optional(string)
      path       = optional(string)
      uid        = optional(number)
    })))
    disk = optional(object({
      acl           = optional(bool)
      datastore_id  = optional(string)
      mount_options = optional(list(string))
      quota         = optional(bool)
      replicate     = optional(bool)
      size          = optional(number)
    }))
    environment_variables = optional(map(string))
    features = optional(object({
      fuse    = optional(bool)
      keyctl  = optional(bool)
      mknod   = optional(bool)
      mount   = optional(list(string))
      nesting = optional(bool)
    }))
    hook_script_file_id = optional(string)
    idmap = optional(list(object({
      container_id = optional(number)
      host_id      = optional(number)
      size         = optional(number)
      type         = optional(string)
    })))
    initialization = optional(object({
      dns = optional(object({
        domain  = optional(string)
        server  = optional(string)
        servers = optional(list(string))
      }))
      entrypoint = optional(string)
      hostname   = optional(string)
      ip_config = optional(object({
        ipv4 = optional(object({
          address = optional(string)
          gateway = optional(string)
        }))
        ipv6 = optional(object({
          address = optional(string)
          gateway = optional(string)
        }))
      }))
      user_account = optional(object({
        keys     = optional(list(string))
        password = optional(string)
      }))
    }))
    memory = optional(object({
      dedicated = optional(number)
      swap      = optional(number)
    }))
    migrate = optional(bool)
    mount_point = optional(object({
      acl           = optional(bool)
      backup        = optional(bool)
      mount_options = optional(list(string))
      path          = optional(string)
      quota         = optional(bool)
      read_only     = optional(bool)
      replicate     = optional(bool)
      shared        = optional(bool)
      size          = optional(string)
      volume        = optional(string)
    }))
    mount_points = optional(list(object({
      acl           = optional(bool)
      backup        = optional(bool)
      mount_options = optional(list(string))
      path          = optional(string)
      quota         = optional(bool)
      read_only     = optional(bool)
      replicate     = optional(bool)
      shared        = optional(bool)
      size          = optional(string)
      volume        = optional(string)
    })))
    network_interface = optional(object({
      bridge       = optional(string)
      enabled      = optional(bool)
      firewall     = optional(bool)
      host_managed = optional(bool)
      mac_address  = optional(string)
      mtu          = optional(number)
      name         = optional(string)
      rate_limit   = optional(number)
      vlan_id      = optional(number)
    }))
    network_interfaces = optional(list(object({
      bridge       = optional(string)
      enabled      = optional(bool)
      firewall     = optional(bool)
      host_managed = optional(bool)
      mac_address  = optional(string)
      mtu          = optional(number)
      name         = optional(string)
      rate_limit   = optional(number)
      vlan_id      = optional(number)
    })))
    node_name = optional(string)
    operating_system = optional(object({
      template_file_id = optional(string)
      type             = optional(string)
    }))
    pool_id          = optional(string)
    protection       = optional(bool)
    purge_on_destroy = optional(bool)
    ssh = optional(object({
      enabled  = optional(bool)
      username = optional(string)
      password = optional(string)
    }))
    start_on_boot = optional(bool)
    started       = optional(bool)
    startup = optional(object({
      down_delay = optional(number)
      order      = optional(number)
      up_delay   = optional(number)
    }))
    tags            = optional(list(string))
    timeout_clone   = optional(number)
    timeout_create  = optional(number)
    timeout_delete  = optional(number)
    timeout_migrate = optional(number)
    timeout_start   = optional(number)
    timeout_update  = optional(number)
    template        = optional(bool)
    unprivileged    = optional(bool)
    vm_id           = optional(number)
    wait_for_ip = optional(object({
      cidrs      = optional(set(string))
      interfaces = optional(set(string))
      ipv4       = optional(bool)
      ipv6       = optional(bool)
      timeout    = optional(string)
    }))
  }))
  default = {}
}

variable "proxmox_virtual_machines" {
  description = "Proxmox VM configuration"
  type = map(object({
    acpi = optional(bool)
    agent = optional(object({
      enabled = optional(bool)
      timeout = optional(string)
      trim    = optional(bool)
      type    = optional(string)
      wait_for_ip = optional(object({
        cidrs      = optional(set(string))
        disabled   = optional(bool)
        interfaces = optional(set(string))
        ipv4       = optional(bool)
        ipv6       = optional(bool)
      }))
    }))
    amd_sev = optional(object({
      allow_smt      = optional(bool)
      kernel_hashes  = optional(bool)
      no_debug       = optional(bool)
      no_key_sharing = optional(bool)
      type           = optional(string)
    }))
    audio_device = optional(object({
      device  = optional(string)
      driver  = optional(string)
      enabled = optional(bool)
    }))
    bios       = optional(string)
    boot_order = optional(list(string))
    cdrom = optional(object({
      enabled   = optional(bool)
      file_id   = optional(string)
      interface = optional(string)
    }))
    clone = optional(object({
      datastore_id = optional(string)
      full         = optional(bool)
      node_name    = optional(string)
      retries      = optional(number)
      vm_id        = number
    }))
    cpu = optional(object({
      affinity     = optional(string)
      architecture = optional(string)
      cores        = optional(number)
      flags        = optional(list(string))
      hotplugged   = optional(number)
      limit        = optional(number)
      numa         = optional(bool)
      sockets      = optional(number)
      type         = optional(string)
      units        = optional(number)
    }))
    delete_unreferenced_disks_on_destroy = optional(bool)
    description                          = optional(string)
    disk = optional(object({
      aio               = optional(string)
      backup            = optional(bool)
      cache             = optional(string)
      datastore_id      = optional(string)
      discard           = optional(string)
      file_format       = optional(string)
      file_id           = optional(string)
      import_from       = optional(string)
      interface         = string
      iothread          = optional(bool)
      path_in_datastore = optional(string)
      queues            = optional(number)
      replicate         = optional(bool)
      serial            = optional(string)
      size              = optional(number)
      speed = optional(object({
        iops_read            = optional(number)
        iops_read_burstable  = optional(number)
        iops_write           = optional(number)
        iops_write_burstable = optional(number)
        read                 = optional(number)
        read_burstable       = optional(number)
        write                = optional(number)
        write_burstable      = optional(number)
      }))
      ssd = optional(bool)
    }))
    disks = optional(list(object({
      aio               = optional(string)
      backup            = optional(bool)
      cache             = optional(string)
      datastore_id      = optional(string)
      discard           = optional(string)
      file_format       = optional(string)
      file_id           = optional(string)
      import_from       = optional(string)
      interface         = string
      iothread          = optional(bool)
      path_in_datastore = optional(string)
      queues            = optional(number)
      replicate         = optional(bool)
      serial            = optional(string)
      size              = optional(number)
      speed = optional(object({
        iops_read            = optional(number)
        iops_read_burstable  = optional(number)
        iops_write           = optional(number)
        iops_write_burstable = optional(number)
        read                 = optional(number)
        read_burstable       = optional(number)
        write                = optional(number)
        write_burstable      = optional(number)
      }))
      ssd = optional(bool)
    })))
    efi_disk = optional(object({
      datastore_id      = optional(string)
      file_format       = optional(string)
      pre_enrolled_keys = optional(bool)
      type              = optional(string)
    }))
    hook_script_file_id = optional(string)
    hostpci = optional(list(object({
      device   = string
      id       = optional(string)
      mapping  = optional(string)
      mdev     = optional(string)
      pcie     = optional(bool)
      rom_file = optional(string)
      rombar   = optional(bool)
      xvga     = optional(bool)
    })))
    hotplug = optional(string)
    initialization = optional(object({
      datastore_id = optional(string)
      dns = optional(object({
        domain  = optional(string)
        servers = optional(list(string))
      }))
      file_format = optional(string)
      interface   = optional(string)
      ip_config = optional(object({
        ipv4 = optional(object({
          address = optional(string)
          gateway = optional(string)
        }))
        ipv6 = optional(object({
          address = optional(string)
          gateway = optional(string)
        }))
      }))
      meta_data_file_id    = optional(string)
      network_data_file_id = optional(string)
      type                 = optional(string)
      upgrade              = optional(bool)
      user_account = optional(object({
        keys     = optional(list(string))
        password = optional(string)
        username = optional(string)
      }))
      user_data_file_id   = optional(string)
      vendor_data_file_id = optional(string)
    }))
    template        = optional(bool)
    keyboard_layout = optional(string)
    kvm_arguments   = optional(string)
    machine         = optional(string)
    memory = optional(object({
      dedicated      = optional(number)
      floating       = optional(number)
      hugepages      = optional(string)
      keep_hugepages = optional(bool)
      shared         = optional(number)
    }))
    migrate = optional(bool)
    name    = optional(string)
    network_device = optional(object({
      bridge       = optional(string)
      disconnected = optional(bool)
      enabled      = optional(bool)
      firewall     = optional(bool)
      mac_address  = optional(string)
      model        = optional(string)
      mtu          = optional(number)
      queues       = optional(number)
      rate_limit   = optional(number)
      trunks       = optional(string)
      vlan_id      = optional(number)
    }))
    network_devices = optional(list(object({
      bridge       = optional(string)
      disconnected = optional(bool)
      enabled      = optional(bool)
      firewall     = optional(bool)
      mac_address  = optional(string)
      model        = optional(string)
      mtu          = optional(number)
      queues       = optional(number)
      rate_limit   = optional(number)
      trunks       = optional(string)
      vlan_id      = optional(number)
    })))
    node_name = optional(string)
    numa = optional(list(object({
      cpus      = string
      device    = string
      hostnodes = optional(string)
      memory    = number
      policy    = optional(string)
    })))
    on_boot = optional(bool)
    operating_system = optional(object({
      type = optional(string)
    }))
    pool_id             = optional(string)
    protection          = optional(bool)
    purge_on_destroy    = optional(bool)
    reboot              = optional(bool)
    reboot_after_update = optional(bool)
    rng = optional(object({
      max_bytes = optional(number)
      period    = optional(number)
      source    = string
    }))
    scsi_hardware = optional(string)
    serial_device = optional(object({
      device = optional(string)
    }))
    smbios = optional(object({
      family       = optional(string)
      manufacturer = optional(string)
      product      = optional(string)
      serial       = optional(string)
      sku          = optional(string)
      uuid         = optional(string)
      version      = optional(string)
    }))
    started = optional(bool)
    startup = optional(object({
      down_delay = optional(number)
      order      = optional(number)
      up_delay   = optional(number)
    }))
    stop_on_destroy     = optional(bool)
    tablet_device       = optional(bool)
    tags                = optional(list(string))
    timeout_clone       = optional(number)
    timeout_create      = optional(number)
    timeout_migrate     = optional(number)
    timeout_move_disk   = optional(number)
    timeout_reboot      = optional(number)
    timeout_shutdown_vm = optional(number)
    timeout_start_vm    = optional(number)
    timeout_stop_vm     = optional(number)
    tpm_state = optional(object({
      datastore_id = optional(string)
      version      = optional(string)
    }))
    usb = optional(list(object({
      host    = optional(string)
      mapping = optional(string)
      usb3    = optional(bool)
    })))
    vga = optional(object({
      clipboard = optional(string)
      memory    = optional(number)
      type      = optional(string)
    }))
    virtiofs = optional(object({
      cache        = optional(string)
      direct_io    = optional(bool)
      expose_acl   = optional(bool)
      expose_xattr = optional(bool)
      mapping      = string
    }))
    vm_id = optional(number)
    watchdog = optional(object({
      action  = optional(string)
      enabled = optional(bool)
      model   = optional(string)
    }))
  }))
  default = {}
}
